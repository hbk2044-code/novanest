# NovaNest - systemd unit (Hostinger VPS / Cloud, non-Docker setups)
#
# Install:
#   sudo cp deploy/novanest.service /etc/systemd/system/novanest.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now novanest
#
# Assumes the repo is at /opt/novanest (adjust WorkingDirectory to your path).
# The web app project lives in the repo's `web/` folder, so the node entry is
# /opt/novanest/web/backend/server.js. The process manager loads
# web/backend/.env itself, so no env-file flags are used.

[Unit]
Description=NovaNest marketplace
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/novanest/web
ExecStart=/usr/bin/node /opt/novanest/web/backend/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Optionally point storage at a dedicated disk:
# Environment=DATA_DIR=/data
# Environment=UPLOAD_DIR=/data/uploads

[Install]
WantedBy=multi-user.target
