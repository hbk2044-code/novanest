# ------------------------------------------------------------
# NovaNest - Nepal payment gateway configuration
# ------------------------------------------------------------
# Copy this file to backend/.env and fill in your merchant keys.

# --- JWT signing secret (required) ---
# The server REFUSES to start if this is missing OR left as the placeholder
# value below. Generate a strong random one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-hex-string

# --- Persistent storage (container/serverless deployments) ---
# The database is a single JSON file and product photos are written to disk,
# so the host MUST provide persistent disk (a mounted volume), or every
# restart wipes orders and images. Point these at a persistent volume to keep
# data across restarts; when unset they default to ./backend/data and
# ./backend/uploads inside the container.
# DATA_DIR=/data
# UPLOAD_DIR=/data/uploads

# --- Initial admin account (only used when seeding an empty database) ---
# Leave ADMIN_PASSWORD unset to have a random password generated and printed
# to the server console once. Never rely on a documented default password.
# To reset the admin password on an existing database, stop the server and run:
#   ADMIN_PASSWORD='Strong-New-Pass!' node reset-admin.js
# ADMIN_EMAIL=admin@novanest.com
# ADMIN_PASSWORD=choose-a-strong-password

# --- Outbound email (password reset) ---
# If SMTP_HOST is empty, reset links are logged to the server console instead
# of being emailed (dev fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NovaNest <no-reply@novanest.local>
# Public base URL used in emailed reset links.
APP_URL=http://localhost:3001

# --- eSewa (https://developer.esewa.com.np) ---
# true = sandbox (rc-*.esewa.com.np), false = live
ESEWA_TEST_MODE=true
# Merchant product code. "EPAYTEST" is the public sandbox code and is only
# used while ESEWA_TEST_MODE=true. Set your LIVE product code before going live.
ESEWA_PRODUCT_CODE=EPAYTEST
# Merchant secret key. The value below is the public sandbox secret and is only
# used while ESEWA_TEST_MODE=true. In live mode an unset/placeholder value is a
# misconfiguration — the server refuses to take eSewa payments with it.
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q(

# --- Khalti (https://docs.khalti.com) ---
# true = sandbox (dev.khalti.com), false = live (khalti.com)
KHALTI_TEST_MODE=true
# Paste your own key below. Get a "test_secret_key" from
# https://test-admin.khalti.com (sandbox) or a "live_secret_key" from
# https://admin.khalti.com (production). NEVER ship a real key here.
# Leave empty to hide Khalti at checkout.
KHALTI_SECRET_KEY=
